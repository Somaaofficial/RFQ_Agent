# Copy this file to rfq_agent/.env for local dev.
# On Render, set these under Settings -> Environment instead.

MISTRAL_API_KEY=your_mistral_key_here
SLACK_BOT_TOKEN=
NEWS_API_KEY=
EMAIL_SENDER=
MANAGER_EMAIL=

# Where uploaded vendor quote PDFs get extracted.
# Leave unset to use ./vendor_quotes next to the app.
VENDOR_QUOTES_FOLDER=
UPLOAD_FOLDER=

# Procurement policy PDF + Chroma vector store location.
# Leave unset to use the repo defaults.
POLICY_PDF=
CHROMA_DIR=

# Set to 1 on Render - disables Windows-only Outlook draft generation.
DISABLE_OUTLOOK=1
